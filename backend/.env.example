# Copy to backend/.env and fill in locally. NEVER commit backend/.env.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Amazon Bedrock (Part 4). The Decider chooses the tool; Bedrock explains the
# numbers the tool produced. Prefer an AWS profile or IAM Identity Center over
# raw keys -- never put an access key or secret in this file.
#
# Claude Haiku 5.5 in ap-south-1 is served by the GLOBAL cross-region inference
# profile only, so BEDROCK_MODEL_ID must keep the "global." prefix. A bare
# "anthropic.claude-haiku-5-5" will not route from that region.
AWS_REGION=ap-south-1
AWS_PROFILE=
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5

# How long to wait for an explanation, and how long it may be.
BEDROCK_TIMEOUT_SECONDS=30
BEDROCK_MAX_TOKENS=600
BEDROCK_TEMPERATURE=0.2

# Set to false to turn the explanation layer off entirely.
BEDROCK_ENABLED=true

# The local Strands Decider 2B service (Part 3). Loopback only -- the service
# has no authentication, so a remote URL is rejected at startup.
# See experiments/decider-spike.md for how to start it.
DECIDER_BASE_URL=http://127.0.0.1:8100
DECIDER_TIMEOUT_SECONDS=15
STRANDS_DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
